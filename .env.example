# Shadow Landing — environment template.
# Copy to `.env.local` (gitignored). Vite only exposes vars prefixed with VITE_.

# ─── Waitlist (primary sink) ─────────────────────────────────────────────────
# Reuse the Shadow app's Supabase project.
# Anon key is safe to expose: the `waitlist` table only grants INSERT
# (see supabase/migrations/20260528_waitlist.sql).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ─── Optional automation fan-out ────────────────────────────────────────────
# Webhook called alongside Supabase write. Use for n8n / Zapier / Make / Loops
# / Resend. Failures are non-fatal.
# Example: http://localhost:5678/webhook/shadow-waitlist
VITE_WAITLIST_ENDPOINT=

# ─── Shadow app destination ─────────────────────────────────────────────────
# "Already have access? Sign in →" link in the CTA modal.
VITE_SHADOW_APP_URL=http://localhost:3007/login
